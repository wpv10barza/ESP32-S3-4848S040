# Gitignore settings for ESPHome
# This is an example and may include too much for your use-case.
# You can modify this file to suit your needs.
src/.esphome/
src/secrets.yaml
.DS_Store

# PlatformIO
.pio/
.platformio/
# Python test/cache
__pycache__/
.pytest_cache/
*.pyc

# 3C local configuration and generated firmware
include/local_config.h
*.bin
*.elf
*.map
credentials.json
.env
